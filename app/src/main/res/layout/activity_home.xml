<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="520dp"
        android:orientation="vertical"
        android:paddingLeft="34dp"
        android:paddingRight="34dp"
        android:paddingTop="24dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TELALEVE  /  ANDROID TV"
                android:textColor="@color/focus"
                android:textSize="15sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:textColor="@color/subtle"
                android:textSize="14sp" />
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/ink"
                android:textSize="29sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Seus aplicativos"
            android:textColor="@color/ink"
            android:textSize="21sp"
            android:textStyle="bold" />
        <HorizontalScrollView
            android:id="@+id/app_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/app_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/recent_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Abertos recentemente"
            android:textColor="@color/subtle"
            android:textSize="13sp"
            android:visibility="gone" />
        <HorizontalScrollView
            android:id="@+id/recent_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/recent_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tile_selector"
                android:hint="Buscar filmes e séries"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:maxLength="90"
                android:padding="13dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/subtle"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/search_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:background="@drawable/tile_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:text="BUSCAR"
                android:textColor="@color/ink"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/catalog_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filmes recentes disponíveis no Brasil"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/reset_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tile_selector"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:text="VOLTAR ÀS NOVIDADES"
                android:textColor="@color/focus"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/type_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/type_movie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tile_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="FILMES"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/type_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:background="@drawable/tile_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="SÉRIES"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/provider_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/provider_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/catalog_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Configure o TMDB para consultar títulos."
            android:textColor="@color/subtle"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:id="@+id/media_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:clipToPadding="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/media_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/organize_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tile_selector"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="ORGANIZAR APPS"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tmdb_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11dp"
                android:background="@drawable/tile_selector"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="CONFIGURAR TMDB"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/settings_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11dp"
                android:background="@drawable/tile_selector"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="CONFIGURAÇÕES TV"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Dados e notas: TMDB  •  Disponibilidade: JustWatch  •  Sobre e créditos"
            android:textColor="@color/subtle"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
